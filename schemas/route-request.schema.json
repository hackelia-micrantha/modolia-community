{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackelia-micrantha/modolia-community/blob/main/schemas/route-request.schema.json",
  "title": "Route Request",
  "description": "Provider-independent task facts and preferences used for model-route resolution. Authority-bearing routing restrictions belong in RouteConstraints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "timestamp", "task"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "task": {"type": "string", "minLength": 1},
    "logical_role": {"type": "string", "minLength": 1},
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "context_estimate": {
      "type": "object", "additionalProperties": false,
      "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "max_output_tokens": {"type": "integer", "minimum": 0}}
    },
    "latency_tolerance": {"type": "string", "enum": ["interactive", "normal", "batch", "unknown"]},
    "cost_preference": {"type": "string", "enum": ["prefer_free", "prefer_low", "no_preference"]},
    "preferred_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "affinity_key": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "external_execution_id": {"type": "string", "minLength": 1},
    "metadata": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
    "quality_tier": {"type": "string", "enum": ["cheap", "balanced", "strong", "reviewer", "final_answer"], "deprecated": true},
    "budget_tolerance": {"type": "string", "enum": ["free_only", "low", "medium", "high", "unknown"], "deprecated": true},
    "classification": {"$ref": "classification.schema.json", "deprecated": true},
    "residency_requirement": {"type": "string", "enum": ["local_required", "ca_required_when_remote", "ca_preferred", "no_requirement", "unknown"], "deprecated": true},
    "remote_allowed": {"type": "boolean", "deprecated": true},
    "remote_allowance_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "deprecated": true},
    "forbidden_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "deprecated": true},
    "approval_evidence": {"$ref": "#/$defs/evidence_ref", "deprecated": true},
    "secret_scan_evidence": {"$ref": "#/$defs/evidence_ref", "deprecated": true}
  },
  "$defs": {
    "evidence_ref": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["not_required", "present", "missing", "failed", "unknown"]},
        "reference": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
