{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackelia-micrantha/modolia-community/blob/main/schemas/classification.schema.json",
  "title": "Classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["privacy_class", "data_classes"],
  "properties": {
    "privacy_class": {"type": "string", "enum": ["local_only", "trusted_cloud_ok", "public_cloud_ok"]},
    "data_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": ["private_source_code", "cloud_allowed_source_code", "public_source_code", "secrets", "unpublished_docs", "cloud_allowed_work_docs", "canadian_sensitive_docs", "sensitive_personal_data", "public_content", "unknown"]}
    },
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "origin": {"type": "string", "enum": ["caller", "local_classifier", "trusted_policy", "human_review"]}
  },
  "allOf": [
    {
      "if": {"properties": {"data_classes": {"contains": {"enum": ["private_source_code", "secrets", "unpublished_docs", "sensitive_personal_data", "unknown"]}}}, "required": ["data_classes"]},
      "then": {"properties": {"privacy_class": {"const": "local_only"}}}
    },
    {
      "if": {"properties": {"confidence": {"const": "low"}}, "required": ["confidence"]},
      "then": {"properties": {"privacy_class": {"const": "local_only"}}}
    }
  ]
}
